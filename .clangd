CompileFlags:
  CompilationDatabase: .
  Remove:
    - /Fo*
    - /Fd*
    - /FS

Completion:
  AllScopes: Yes
  HeaderInsertion: IWYU

Diagnostics:
  MissingIncludes: None
  UnusedIncludes: Strict
  Includes:
    AnalyzeAngledIncludes: true

Index:
  Background: Build

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes
  DefaultArguments: Yes

---
If:
  PathMatch: (oldsrc|third_party|build|\.ref-repos)/.*
Index:
  Background: Skip
Diagnostics:
  Suppress: "*"
