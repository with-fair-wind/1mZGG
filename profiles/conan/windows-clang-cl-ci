{% set compiler, version, compiler_exe = detect_api.detect_clang_compiler(compiler_exe="clang-cl") %}

[settings]
os=Windows
arch=x86_64
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.cppstd=23
compiler.runtime=dynamic
# Conan's clang mapping uses v144 to activate MSVC 14.4x (VS 2022).
# Microsoft's platform toolset name remains v143.
compiler.runtime_version=v144

[conf]
tools.build:compiler_executables={"c": "{{ compiler_exe }}", "cpp": "{{ compiler_exe }}"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.microsoft.msbuild:vs_version=17
